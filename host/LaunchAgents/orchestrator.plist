<?xml version="1.0" encoding="UTF-8"?>
<!--
  @LABEL@ — fires the orchestrator dispatch cycle on a weeknight schedule. Canonical
  TEMPLATE lives here in the repo with @ORCH@/@LABEL@/@HOME@ placeholders; schedule.sh
  renders it (stamping in the live repo path, the operator's launchd label from
  orchestrator.conf, and HOME) into ~/Library/LaunchAgents/ and bootstraps it (portability
  model: host bits live in-repo, but launchd needs absolute paths baked in, so they get
  stamped in at install time — re-run './schedule.sh install' after moving the repo, and
  'schedule.sh status' will flag it if you forget).

  - StartCalendarInterval is GENERATED, not hand-maintained: schedule.sh's render_plist
    replaces the @CALENDAR_INTERVAL@ marker below with one <dict> per slot, derived from
    the single source of truth — SCHEDULE_SLOTS in orchestrator.conf (the same list that
    drives the pmset wake chain). So the wake and the fire can never desync; change the
    cadence in one place. Slots fire 15 min EARLY (e.g. :45 of the prior hour) and the
    `--jitter` flag makes run-cycle.sh sleep a random 0–30 min, so each cycle starts
    uniformly within ±15 min of its center — de-syncing us from other hosts' on-the-hour
    cron jobs (avoids a synchronized server stampede).
  - WeekdayInterval matters less here (the slots span midnight), so we DON'T pin a
    Weekday — pmset already gates power-on to weekdays (MTWRF) and run-cycle.sh's
    usage gate skips spent windows. Keep it simple: fire at every slot, every day.
  - No RunAtLoad: we do NOT want a dispatch on every login/reboot — only on schedule
    (and the manual `schedule.sh run` kickstart).
  - Plan-only vs live is NOT set here — it's a persistent toggle in state/mode, flipped
    by `schedule.sh live` / `schedule.sh plan-only` and read by run-cycle.sh on every
    fire. So this plist never needs hand-editing to go live or back. Default (no toggle
    set) is plan-only, so a fresh install never dispatches for real until you opt in.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@ORCH@/bin/run-cycle.sh</string>
    <string>--jitter</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>

  <!-- GENERATED from SCHEDULE_SLOTS by schedule.sh render_plist — do not hand-edit.
       Each slot fires 15 min EARLY; --jitter then sleeps 0–30 min -> ±15 of center. -->
  <key>StartCalendarInterval</key>
  <array>
@CALENDAR_INTERVAL@
  </array>

  <!-- launchd captures the wrapper's own stdout/stderr; run-cycle.sh also tees the
       human-readable cycle log to logs/cycle.log. These catch early/PATH failures
       that happen before the script can log. -->
  <key>StandardOutPath</key>
  <string>@ORCH@/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>@ORCH@/logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
