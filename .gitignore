# Orchestrator runtime state (machine-local: dispatch ledger + worker logs)
ledger.md
logs/
state/

# Per-project manifests are machine-specific (real repo names, local clone/data
# paths, confidentiality notes) — kept on disk, never tracked. The tracked, sanitized
# shape lives in templates/project.yml; new-project.sh scaffolds one from it.
projects/*.yml

# Per-operator identity config (scaffolded from orchestrator.conf.example)
orchestrator.conf

