# Orchestrator runtime state (machine-local: dispatch ledger + worker logs)
ledger.md
logs/
state/

# Per-project manifests are machine-specific (real repo names, local clone/data
# paths, confidentiality notes) — kept on disk, never tracked. The tracked, sanitized
# shape lives in templates/project.yml; new-project.sh scaffolds one from it.
projects/*.yml
# ...with ONE exception: the off-board exemplar the `board: none` documentation points
# at (issue #86). It is `~`-relative and machine-independent, so unlike a real research
# manifest it carries no local path. Drop this line and the file to go back to
# "no manifest is ever tracked".
!projects/financial-planning.yml

# Per-operator identity config (scaffolded from orchestrator.conf.example)
orchestrator.conf

# Python bytecode — running the deny-hook (directly or via the test suite) writes it
__pycache__/

# macOS
.DS_Store
